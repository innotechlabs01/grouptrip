# Polar.sh payment provider configuration.
# Copy to .env.local and fill with your Polar org's real values.
# See docs/platform/01-architecture/fund-spec.md §9 for the Polar contract.

# API root WITHOUT /v1 (the adapter appends /v1/...). Sandbox vs production:
#   sandbox:    https://sandbox-api.polar.sh
#   production: https://api.polar.sh
POLAR_BASE_URL=https://sandbox-api.polar.sh

# Polar API access token (org token). Scope requires at least: orders:write.
POLAR_TOKEN=

# Webhook signing secret (created on the Polar webhook endpoint, Standard Webhooks HMAC-SHA256).
POLAR_WEBHOOK_SECRET=

# One-time product id used as the contribution "product" reference.
POLAR_PRODUCT_ID=

# Polar environment label (sandbox | production). Informational for tooling.
POLAR_ENV=sandbox

# Database (Turso/libSQL). Local SQLite fallback used when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# HTTP listen port for the API server.
PORT=8080
